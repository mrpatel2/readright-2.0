rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // The previous rule here hard-expired on 2025-11-30 (a "getting
      // started" default from Firebase console setup) and was silently
      // denying every read/write app-wide once that date passed — not just
      // for new M3 features, the entire Firestore-backed app (roster,
      // classes, stories) was locked out. Requiring sign-in is the minimum
      // real rule; per-collection ownership rules are still a TODO before
      // this app handles real student data outside a course context.
      allow read, write: if request.auth != null;
    }
  }
}
